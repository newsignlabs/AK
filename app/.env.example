# Public, build-time values only. Never put secrets here.
# Base URL of the Catalyst project that hosts the `enquiry` function,
# e.g. https://akstudio-60012345678.development.catalystserverless.in
VITE_API_BASE=
# Cloudflare Turnstile site key (leave empty to disable the widget)
VITE_TURNSTILE_SITEKEY=
# Plausible analytics domain, e.g. akstudio.in (leave empty to disable)
VITE_PLAUSIBLE_DOMAIN=
